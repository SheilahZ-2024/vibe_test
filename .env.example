# Product
PRODUCT_NAME=Douyin Life Service Assistant
DEFAULT_USER_ID=user_demo
DEFAULT_CITY=北京

# Database
POSTGRES_USER=smart_assistant
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=smart_assistant
DATABASE_URL=postgresql+asyncpg://smart_assistant:change_me_in_production@postgres:5432/smart_assistant

# Redis
REDIS_URL=redis://redis:6379/0

# LLM（OpenAI-compatible API，如豆包/火山方舟）
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-1-8-251228
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.8
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_FALLBACK_TO_MOCK=true

# 意图识别（轻量 LLM 分类 + 置信度阈值）
INTENT_CONFIDENCE_THRESHOLD=0.65
INTENT_USE_LLM=true
INTENT_LLM_TEMPERATURE=0.1
INTENT_LLM_MAX_TOKENS=256

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_jwt_or_internal_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Web
VITE_API_BASE_URL=
