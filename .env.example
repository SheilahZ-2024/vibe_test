# Product
PRODUCT_NAME=Douyin Life Service Assistant
DEFAULT_USER_ID=user_demo
DEFAULT_CITY=北京

# Database
POSTGRES_USER=smart_assistant
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=smart_assistant
DATABASE_URL=postgresql+asyncpg://smart_assistant:change_me_in_production@postgres:5432/smart_assistant

# Redis
REDIS_URL=redis://redis:6379/0

# LLM (OpenAI-compatible; Doubao/Volcengine Ark)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_MODEL=doubao-seed-1-8-251228
OPENAI_TEMPERATURE=0.3
OPENAI_TOP_P=0.8
OPENAI_MAX_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=60
OPENAI_FALLBACK_TO_MOCK=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_jwt_or_internal_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Web
VITE_API_BASE_URL=http://localhost:8000
