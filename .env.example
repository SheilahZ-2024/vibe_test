# Product
PRODUCT_NAME=Douyin Life Service Assistant
DEFAULT_USER_ID=user_demo
DEFAULT_CITY=北京

# Database
POSTGRES_USER=smart_assistant
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=smart_assistant
DATABASE_URL=postgresql+asyncpg://smart_assistant:change_me_in_production@postgres:5432/smart_assistant

# Redis
REDIS_URL=redis://redis:6379/0

# LLM（OpenAI-compatible API，如豆包/火山方舟）
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-1-8-251228
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.8
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
# 生产/演示建议 false：无 Key 时不静默 Mock
LLM_FALLBACK_TO_MOCK=false
LLM_REQUIRE_LIVE=true

# 意图识别（关键词优先，仅低置信度才调轻量 LLM）
INTENT_CONFIDENCE_THRESHOLD=0.65
INTENT_USE_LLM=true
INTENT_LLM_TEMPERATURE=0.1
INTENT_LLM_MAX_TOKENS=256

# 统一 Turn Pipeline（Plan → Gather ReAct → Compose）
AGENT_HISTORY_MAX_TURNS=4

# Gather ReAct（模型主导查规则/选工具，有界 1~3 步/轮）
AGENT_GATHER_MAX_STEPS=3
AGENT_GATHER_TEMPERATURE=0.2
AGENT_GATHER_MAX_TOKENS=512
AGENT_PREFETCH_FOCUS_BUNDLE=true

# Compose 成稿（唯一成稿 LLM；致谢接话走模板）
AGENT_COMPOSE_TEMPERATURE=0.35
AGENT_COMPOSE_MAX_TOKENS=768
AGENT_COMPOSE_MAX_RETRIES=1

# 已废弃（保留兼容）
AGENT_FAST_TURN_ENABLED=false
# 终稿语气润色（可选；开启后二次 LLM，会补 emoji，略增延迟）
AGENT_TONE_POLISH_ENABLED=false
AGENT_REACT_STREAM_JSON=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_jwt_or_internal_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Web
VITE_API_BASE_URL=
