# Product
PRODUCT_NAME=Douyin Life Service Assistant
DEFAULT_USER_ID=user_demo
DEFAULT_CITY=北京

# Database
POSTGRES_USER=smart_assistant
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=smart_assistant
DATABASE_URL=postgresql+asyncpg://smart_assistant:change_me_in_production@postgres:5432/smart_assistant

# Redis
REDIS_URL=redis://redis:6379/0

# LLM（OpenAI-compatible API，如豆包/火山方舟）
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-1-8-251228
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.8
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
# 生产/演示建议 false：无 Key 时不静默 Mock
LLM_FALLBACK_TO_MOCK=false
LLM_REQUIRE_LIVE=true

# 意图识别（关键词优先，仅低置信度才调轻量 LLM）
INTENT_CONFIDENCE_THRESHOLD=0.65
INTENT_USE_LLM=true
INTENT_LLM_TEMPERATURE=0.1
INTENT_LLM_MAX_TOKENS=256

# ReAct Agent 性能（体验与准确性平衡）
AGENT_MAX_STEPS=5
AGENT_REACT_MAX_TOKENS=512
AGENT_HISTORY_MAX_TURNS=4
AGENT_SKIP_FINAL_LLM_WHEN_DRAFT=true
AGENT_DRAFT_MIN_CHARS=24

# 终稿语气润色（轻量 LLM，只改表达不改事实）
AGENT_TONE_POLISH_ENABLED=true
AGENT_TONE_POLISH_TEMPERATURE=0.72
AGENT_TONE_POLISH_MAX_TOKENS=384
AGENT_TONE_POLISH_MIN_CHARS=8

# 性能优化（默认开启；不改变回复事实，润色失败时保留 draft）
AGENT_EARLY_DRAFT_STREAM=true
AGENT_PREFETCH_FOCUS_BUNDLE=true
AGENT_REACT_STREAM_JSON=true
AGENT_COALESCE_FOCUS_READS=true
AGENT_HIDE_ATOMIC_FOCUS_READS=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_jwt_or_internal_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Web
VITE_API_BASE_URL=
